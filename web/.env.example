# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않음)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com 에서 발급. 서버 전용
ANTHROPIC_API_KEY=

# Python 워커 주소 (로컬 개발 기본값)
WORKER_URL=http://localhost:8000

# 교사 회원가입 때 입력하는 코드. 원장님이 선생님들께만 알려 줌
TEACHER_SIGNUP_CODE=
